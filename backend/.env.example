# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
DATABASE_URL=postgresql://myplace_user:CHANGE_ME@localhost:5432/myplace_db
# Set to "true" only when your Postgres provider requires SSL (most managed hosts)
DATABASE_SSL=false

# ------------------------------------------------------------
# Auth
# ------------------------------------------------------------
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------
# CORS / frontend
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# Comma-separated list is supported for local and deployed frontend URLs.
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------
# Public-facing contact configuration
# ------------------------------------------------------------
WHATSAPP_NUMBER=254700000000
CONTACT_EMAIL=info@myplacediani.example

# ------------------------------------------------------------
# Used only by the create-admin script (never commit real values)
# ------------------------------------------------------------
INITIAL_ADMIN_NAME=Villa Manager
INITIAL_ADMIN_EMAIL=admin@myplacediani.example
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
